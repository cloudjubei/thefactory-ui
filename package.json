{
  "name": "thefactory-ui",
  "version": "0.2.0",
  "description": "Shared UI package for thefactory-* consumers (web, Electron, future React Native).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js"
    },
    "./headless/api": {
      "types": "./dist/headless/api/index.d.ts",
      "import": "./dist/headless/api/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./web/icons": {
      "types": "./dist/web/icons/index.d.ts",
      "import": "./dist/web/icons/index.js"
    },
    "./web/styles": "./dist/styles/index.css",
    "./web/styles/tokens": "./dist/styles/tokens.css",
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js",
      "react-native": "./dist/native/index.js"
    },
    "./native/styles": "./dist/native/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:uikit": "bash scripts/check-uikit-boundaries.sh",
    "generate:tokens": "tsx scripts/generate-tokens-css.ts",
    "generate:backend": "openapi-ts && prettier --write './src/headless/api/generated/**/*'",
    "prebuild": "npm run check:uikit && npm run generate:tokens",
    "pretest": "npm run check:uikit",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "playground:dev": "vite playground",
    "playground": "npm run build && vite build playground && vite preview playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": ">=0.76.0",
    "react-native-markdown-display": ">=7.0.0",
    "react-native-syntax-highlighter": ">=2.0.0",
    "thefactory-tools": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-markdown-display": {
      "optional": true
    },
    "react-native-syntax-highlighter": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "reconnecting-websocket": "^4.4.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.3",
    "nativewind": "^4.2.4",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-native": "^0.85.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-syntax-highlighter": "^2.1.0",
    "tailwindcss": "^4.1.13",
    "thefactory-tools": "file:../thefactory-tools",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudjubei/thefactory-ui.git"
  }
}
