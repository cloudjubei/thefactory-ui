{
  "name": "thefactory-ui",
  "version": "0.0.1",
  "description": "Shared UI package for thefactory-* consumers (web, Electron, future React Native).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./web/icons": {
      "types": "./dist/web/icons/index.d.ts",
      "import": "./dist/web/icons/index.js"
    },
    "./web/styles": "./dist/styles/index.css",
    "./web/styles/tokens": "./dist/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:uikit": "bash scripts/check-uikit-boundaries.sh",
    "generate:tokens": "tsx scripts/generate-tokens-css.ts",
    "prebuild": "npm run check:uikit && npm run generate:tokens",
    "pretest": "npm run check:uikit",
    "build": "tsup",
    "dev": "tsup --watch",
    "playground:dev": "vite playground",
    "playground": "npm run build && vite build playground && vite preview playground",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "clsx": "^2.1.1",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudjubei/thefactory-ui.git"
  }
}
